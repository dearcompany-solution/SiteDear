{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {"key": "Cache-Control", "value": "no-store"},
        {"key": "Surrogate-Control", "value": "no-store"},
        {"key": "CDN-Cache-Control", "value": "no-store"}
      ]
    }
  ],
  "functions": { "api/meta-sync.js": { "maxDuration": 60 } },
  "crons": [{ "path": "/api/meta-sync?all=1&days=14", "schedule": "0 22 * * *" }]
}
